diff --git a/nobodywho/core/src/errors.rs b/nobodywho/core/src/errors.rs
index 7d16848..611a34c 100644
--- a/nobodywho/core/src/errors.rs
+++ b/nobodywho/core/src/errors.rs
@@ -405,6 +405,12 @@ pub enum InitWorkerError {
     #[error("MTP speculative decoding failed to initialize: {0}")]
     MtpSpeculative(#[from] llama_cpp_2::speculative::MtpSpeculativeError),
 
+    #[error("Could not load LoRA adapter '{path}': {reason}")]
+    LoraLoad { path: String, reason: String },
+
+    #[error("Could not apply LoRA adapter: {0}")]
+    LoraApply(#[from] llama_cpp_2::LlamaLoraAdapterSetError),
+
     #[error("MTP requested but no draft model was loaded")]
     #[diagnostic(
         code(nobodywho::mtp_draft_model_not_loaded),
diff --git a/nobodywho/core/src/llm.rs b/nobodywho/core/src/llm.rs
index c67d545..38c51a0 100644
--- a/nobodywho/core/src/llm.rs
+++ b/nobodywho/core/src/llm.rs
@@ -44,6 +44,9 @@ pub struct Model {
     pub(crate) language_model: LlamaModel,
     pub(crate) projection_model: Option<Mutex<ProjectionModel>>,
     pub(crate) draft_model: Option<DraftModel>,
+    /// lora-per-chat: LoRA adapters loaded for this model, keyed by file path. Each file is
+    /// loaded once and shared by every chat that asks for it.
+    pub(crate) loras: Mutex<std::collections::HashMap<String, Arc<llama_cpp_2::model::LlamaLoraAdapter>>>,
 }
 
 #[derive(Debug)]
@@ -77,6 +80,37 @@ impl Model {
         self.language_model.n_ctx_train()
     }
 
+    /// lora-per-chat: get (loading on first use) the LoRA adapter at `path`.
+    pub(crate) fn lora(
+        &self,
+        path: &str,
+    ) -> Result<Arc<llama_cpp_2::model::LlamaLoraAdapter>, InitWorkerError> {
+        let mut loras = self.loras.lock().map_err(|_| InitWorkerError::LoraLoad {
+            path: path.to_string(),
+            reason: "lora cache lock poisoned".into(),
+        })?;
+        if let Some(adapter) = loras.get(path) {
+            return Ok(adapter.clone());
+        }
+        if !std::path::Path::new(path).exists() {
+            return Err(InitWorkerError::LoraLoad {
+                path: path.to_string(),
+                reason: "file not found".into(),
+            });
+        }
+        let adapter = self
+            .language_model
+            .lora_adapter_init_shared(path)
+            .map_err(|e| InitWorkerError::LoraLoad {
+                path: path.to_string(),
+                reason: e.to_string(),
+            })?;
+        info!(path, "Loaded LoRA adapter");
+        let adapter = Arc::new(adapter);
+        loras.insert(path.to_string(), adapter.clone());
+        Ok(adapter)
+    }
+
     pub fn is_generative_model(&self) -> bool {
         let Ok(arch) = self.language_model.meta_val_str("general.architecture") else {
             return true;
@@ -284,6 +318,7 @@ pub fn get_model_cancellable(
         language_model,
         projection_model,
         draft_model,
+        loras: Mutex::new(std::collections::HashMap::new()),
     })
 }
 
diff --git a/nobodywho/godot/src/chat.rs b/nobodywho/godot/src/chat.rs
index e6d9cec..0545bac 100644
--- a/nobodywho/godot/src/chat.rs
