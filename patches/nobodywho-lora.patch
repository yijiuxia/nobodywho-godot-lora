@@ -49,6 +49,9 @@ impl NobodyWhoChat {
     /// `config` is a Dictionary with optional keys:
     /// - `"system_prompt"` (String): the system prompt.
     /// - `"n_ctx"` (int): context window size (default 4096).
+    /// - `"lora_path"` (String): lora-per-chat: LoRA adapter (GGUF) used by this chat only. Empty = none.
+    ///   Chats sharing one NobodyWhoModel load each adapter file once.
+    /// - `"lora_scale"` (float): lora-per-chat: strength of that adapter (default 1.0).
     /// - `"n_threads"` (int): inference thread count (default: auto-detect).
     /// - `"use_gpu"` (bool, default true): only used when `model` is a path;
     ///   a NobodyWhoModel already carries its own GPU setting.
@@ -574,6 +577,8 @@ impl NobodyWhoChat {
                 "tools",
                 "mtp",
                 "context_shift",
+                "lora_path",
+                "lora_scale",
             ],
         )?;
         let defaults = nobodywho::chat::ChatConfig::default();
@@ -598,6 +603,15 @@ impl NobodyWhoChat {
                 Some(value) => parse_context_shift(&value)?,
                 None => defaults.context_shift,
             },
+            // lora-per-chat: per-chat LoRA adapter
+            lora: dict_get::<GString>(config, "lora_path")?
+                .map(|p| p.to_string())
+                .filter(|p| !p.is_empty())
+                .map(|p| -> Result<(String, f32), String> {
+                    let scale = dict_get::<f64>(config, "lora_scale")?.unwrap_or(1.0) as f32;
+                    Ok((p, scale))
+                })
+                .transpose()?,
             ..defaults
         };
         let use_gpu = dict_get::<bool>(config, "use_gpu")?.unwrap_or(true);
